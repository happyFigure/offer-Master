JOBPILOT_ENV=local
JOBPILOT_API_HOST=127.0.0.1
JOBPILOT_API_PORT=8000
JOBPILOT_LOG_LEVEL=INFO
JOBPILOT_LOG_DIR=./logs
JOBPILOT_UPLOADS_PATH=./data/uploads
JOBPILOT_IMPORTS_PATH=./data/imports
JOBPILOT_EXPORTS_PATH=./data/exports
JOBPILOT_DATABASE_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3306/offermaster?charset=utf8mb4
JOBPILOT_VECTOR_STORE_PATH=./data/vector_store
JOBPILOT_VECTOR_STORE_PROVIDER=deferred
JOBPILOT_MCP_ENABLED=false
JOBPILOT_MCP_SERVER_URL=
JOBPILOT_MCP_TOOL_ALLOWLIST=open_page,read_page,fill_form
JOBPILOT_XIAOHONGSHU_MCP_BASE_URL=
JOBPILOT_XIAOHONGSHU_MCP_AUTH_TOKEN=CHANGE_ME
JOBPILOT_JOB_PROVIDERS=mock,import_file
JOBPILOT_WORKER_POLL_INTERVAL_SECONDS=30
JOBPILOT_WORKER_MAX_RETRIES=3
JOBPILOT_EXTERNAL_AGENT_AUTO_DISPATCH=false
JOBPILOT_CLAUDE_SDK_AGENT_BASE_URL=http://127.0.0.1:18008
JOBPILOT_CLAUDE_SDK_AGENT_API_KEY=CHANGE_ME
JOBPILOT_CLAUDE_SDK_AGENT_MODEL=MiniMax-M2.7
JOBPILOT_CLAUDE_SDK_AGENT_TIMEOUT_SECONDS=300
JOBPILOT_OPENAI_SDK_AGENT_ENABLED=false
JOBPILOT_OPENAI_SDK_AGENT_BASE_URL=
JOBPILOT_OPENAI_SDK_AGENT_API_KEY=CHANGE_ME
JOBPILOT_OPENAI_SDK_AGENT_MODEL=
JOBPILOT_OPENAI_SDK_AGENT_TIMEOUT_SECONDS=120
JOBPILOT_SPEECH_PROVIDER=web_speech
JOBPILOT_LLM_PROVIDER=bailian
JOBPILOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JOBPILOT_LLM_API_KEY=CHANGE_ME
JOBPILOT_LLM_MODEL=qwen-plus
JOBPILOT_LLM_TIMEOUT_SECONDS=60
JOBPILOT_LLM_MAX_RETRIES=2
# Enable the execution-level Planner controller after validating model JSON behavior.
JOBPILOT_EXECUTION_PLANNER_ENABLED=false
# Optional intent-understanding model. Leave blank to reuse JOBPILOT_LLM_*.
JOBPILOT_INTENT_LLM_PROVIDER=bailian
JOBPILOT_INTENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JOBPILOT_INTENT_LLM_API_KEY=
JOBPILOT_INTENT_LLM_MODEL=qwen-turbo
JOBPILOT_INTENT_LLM_TIMEOUT_SECONDS=15
JOBPILOT_INTENT_LLM_MAX_RETRIES=1
JOBPILOT_EMBEDDING_PROVIDER=disabled
